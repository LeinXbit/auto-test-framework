# 复制本文件为 .env 并填入真实值(.env 已在 .gitignore 中, 不会提交)
# 所有敏感配置优先走环境变量, settings.py 内置极简 .env 加载器自动读取本文件

# 测试目标环境(对应 config/environments/<TEST_ENV>.yaml), 默认 go_vue_admin
TEST_ENV=go_vue_admin

# GVA 数据库连接(用于 DB 断言与清理兜底)
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=root
DB_PASSWORD=
DB_DATABASE=gva

# GVA 管理员账号(用于 fixture 自动登录)
ADMIN_USERNAME=admin
ADMIN_PASSWORD=123456
